{"caseId":"g_kentei-failure-0002","examId":"g_kentei","subjectId":"ml_overview","curve":[{"epoch":1,"trainLoss":1.2,"valLoss":1.3},{"epoch":3,"trainLoss":1.0,"valLoss":1.1},{"epoch":5,"trainLoss":0.9,"valLoss":1.0},{"epoch":8,"trainLoss":0.85,"valLoss":0.95},{"epoch":12,"trainLoss":0.82,"valLoss":0.92},{"epoch":16,"trainLoss":0.80,"valLoss":0.90},{"epoch":20,"trainLoss":0.79,"valLoss":0.89}],"symptomOptions":[{"optionId":"overfit","text":"過学習","isCorrect":false},{"optionId":"underfit","text":"未学習","isCorrect":true},{"optionId":"leakage","text":"データリーク","isCorrect":false},{"optionId":"lr-low","text":"学習率が小さすぎる","isCorrect":false}],"treatmentOptions":[{"optionId":"bigger-model","text":"モデルの表現力を上げる(層・ユニット数を増やす)か、学習をもっと続ける","isCorrect":true},{"optionId":"regularize","text":"正則化(Dropoutなど)を強める","isCorrect":false},{"optionId":"fix-split","text":"検証データの前処理を特徴量作成より前に完全に分離する","isCorrect":false},{"optionId":"lr-down","text":"学習率を小さくする","isCorrect":false}],"explanation":"訓練誤差・検証誤差とも下がりはするが、どちらも高い値のまま早々に停滞する。これが未学習の典型的な学習曲線。モデルの表現力が不足している、または学習が十分に進んでいない状態。層やユニット数を増やす、学習を続けるなどが有効。","source":"original","sourceRef":"自作","contentVer":"1"}
{"caseId":"g_kentei-failure-0003","examId":"g_kentei","subjectId":"ml_overview","curve":[{"epoch":1,"trainLoss":1.0,"valLoss":0.9},{"epoch":3,"trainLoss":0.6,"valLoss":0.5},{"epoch":5,"trainLoss":0.35,"valLoss":0.25},{"epoch":8,"trainLoss":0.2,"valLoss":0.12},{"epoch":12,"trainLoss":0.1,"valLoss":0.05},{"epoch":16,"trainLoss":0.05,"valLoss":0.02},{"epoch":20,"trainLoss":0.02,"valLoss":0.01}],"symptomOptions":[{"optionId":"overfit","text":"過学習","isCorrect":false},{"optionId":"leakage","text":"データリーク","isCorrect":true},{"optionId":"underfit","text":"未学習","isCorrect":false},{"optionId":"bias","text":"訓練・検証データの分布の偏り","isCorrect":false}],"treatmentOptions":[{"optionId":"fix-split","text":"検証データの前処理・特徴量作成を訓練データと完全に分離する","isCorrect":true},{"optionId":"regularize","text":"正則化(Dropoutなど)を強める","isCorrect":false},{"optionId":"bigger-model","text":"モデルの表現力を上げる(層・ユニット数を増やす)","isCorrect":false},{"optionId":"cross-validate","text":"交差検証を行う","isCorrect":false}],"explanation":"検証誤差が訓練誤差より一貫して低い。通常、モデルは訓練データに最も良く適合するはずなので、これは不自然でデータリークの典型的な兆候。前処理や特徴量作成の際に検証データの情報が訓練側に漏れている可能性がある。データ分割のやり直しが必要。","source":"original","sourceRef":"自作","contentVer":"1"}
{"caseId":"g_kentei-failure-0004","examId":"g_kentei","subjectId":"dl_elements","curve":[{"epoch":1,"trainLoss":1.3,"valLoss":1.35},{"epoch":3,"trainLoss":1.28,"valLoss":1.33},{"epoch":5,"trainLoss":1.27,"valLoss":1.32},{"epoch":8,"trainLoss":1.26,"valLoss":1.31},{"epoch":12,"trainLoss":1.25,"valLoss":1.30},{"epoch":16,"trainLoss":1.25,"valLoss":1.30},{"epoch":20,"trainLoss":1.24,"valLoss":1.29}],"symptomOptions":[{"optionId":"vanishing","text":"勾配消失","isCorrect":true},{"optionId":"underfit","text":"未学習","isCorrect":false},{"optionId":"lr-low","text":"学習率が小さすぎる","isCorrect":false},{"optionId":"exploding","text":"勾配爆発","isCorrect":false}],"treatmentOptions":[{"optionId":"relu-bn","text":"活性化関数をReLU系に変える、バッチ正規化や残差接続を使う","isCorrect":true},{"optionId":"bigger-model","text":"モデルの表現力を上げる(層・ユニット数を増やす)","isCorrect":false},{"optionId":"lr-up","text":"学習率を大きくする","isCorrect":false},{"optionId":"clip-grad","text":"勾配クリッピングを使う","isCorrect":false}],"explanation":"誤差がほとんど下がらずほぼ平坦。層が深いネットワークでシグモイド系の活性化関数を使うと、逆伝播のたびに勾配が小さくなり、入力側の層にほとんど学習信号が届かなくなる（勾配消失）。ReLU系の活性化関数やバッチ正規化、残差接続が有効。","source":"original","sourceRef":"自作","contentVer":"1"}
{"caseId":"g_kentei-failure-0005","examId":"g_kentei","subjectId":"dl_elements","curve":[{"epoch":1,"trainLoss":1.2,"valLoss":1.3},{"epoch":3,"trainLoss":1.6,"valLoss":1.7},{"epoch":5,"trainLoss":0.9,"valLoss":1.0},{"epoch":8,"trainLoss":1.8,"valLoss":1.9},{"epoch":12,"trainLoss":0.7,"valLoss":0.8},{"epoch":16,"trainLoss":2.0,"valLoss":2.1},{"epoch":20,"trainLoss":1.1,"valLoss":1.2}],"symptomOptions":[{"optionId":"lr-high","text":"学習率が大きすぎる","isCorrect":true},{"optionId":"exploding","text":"勾配爆発","isCorrect":false},{"optionId":"overfit","text":"過学習","isCorrect":false},{"optionId":"bias","text":"訓練・検証データの分布の偏り","isCorrect":false}],"treatmentOptions":[{"optionId":"lr-down","text":"学習率を小さくする","isCorrect":true},{"optionId":"clip-grad","text":"勾配クリッピングを使う","isCorrect":false},{"optionId":"regularize","text":"正則化(Dropoutなど)を強める","isCorrect":false},{"optionId":"lr-up","text":"学習率を大きくする","isCorrect":false}],"explanation":"誤差が大きく上下に振動し、全体として下がっていかない。学習率が大きすぎると、パラメータの更新幅が大きくなりすぎて最小値を飛び越えてしまい、収束できない。学習率を小さくする、または学習率を自動調整するスケジューリングが有効。","source":"original","sourceRef":"自作","contentVer":"1"}
{"caseId":"g_kentei-failure-0006","examId":"g_kentei","subjectId":"dl_elements","curve":[{"epoch":1,"trainLoss":1.3,"valLoss":1.35},{"epoch":3,"trainLoss":1.28,"valLoss":1.33},{"epoch":5,"trainLoss":1.25,"valLoss":1.30},{"epoch":8,"trainLoss":1.22,"valLoss":1.27},{"epoch":12,"trainLoss":1.19,"valLoss":1.24},{"epoch":16,"trainLoss":1.16,"valLoss":1.21},{"epoch":20,"trainLoss":1.13,"valLoss":1.18}],"symptomOptions":[{"optionId":"lr-low","text":"学習率が小さすぎる","isCorrect":true},{"optionId":"vanishing","text":"勾配消失","isCorrect":false},{"optionId":"underfit","text":"未学習","isCorrect":false},{"optionId":"lr-high","text":"学習率が大きすぎる","isCorrect":false}],"treatmentOptions":[{"optionId":"lr-up","text":"学習率を大きくする、または学習率スケジューリングを使う","isCorrect":true},{"optionId":"relu-bn","text":"活性化関数をReLU系に変える、バッチ正規化を使う","isCorrect":false},{"optionId":"bigger-model","text":"モデルの表現力を上げる(層・ユニット数を増やす)","isCorrect":false},{"optionId":"lr-down","text":"学習率を小さくする","isCorrect":false}],"explanation":"誤差はゆっくりと直線的に下がり続けている。勾配消失(ほぼ平坦)とは違い下降トレンドはあるが、学習率が小さすぎるため1エポックあたりの進み方がとても遅い。学習率を大きくする、または学習が進むにつれて学習率を調整するスケジューリングが有効。","source":"original","sourceRef":"自作","contentVer":"1"}
{"caseId":"g_kentei-failure-0007","examId":"g_kentei","subjectId":"dl_elements","curve":[{"epoch":1,"trainLoss":1.2,"valLoss":1.3},{"epoch":3,"trainLoss":0.8,"valLoss":0.9},{"epoch":5,"trainLoss":0.5,"valLoss":0.6},{"epoch":8,"trainLoss":0.3,"valLoss":0.4},{"epoch":12,"trainLoss":1.5,"valLoss":1.6},{"epoch":16,"trainLoss":4.0,"valLoss":4.2},{"epoch":20,"trainLoss":9.0,"valLoss":9.5}],"symptomOptions":[{"optionId":"exploding","text":"勾配爆発","isCorrect":true},{"optionId":"lr-high","text":"学習率が大きすぎる","isCorrect":false},{"optionId":"overfit","text":"過学習","isCorrect":false},{"optionId":"vanishing","text":"勾配消失","isCorrect":false}],"treatmentOptions":[{"optionId":"clip-grad","text":"勾配クリッピングを使う、学習率を下げる","isCorrect":true},{"optionId":"lr-up","text":"学習率を大きくする","isCorrect":false},{"optionId":"relu-bn","text":"活性化関数をReLU系に変える、バッチ正規化を使う","isCorrect":false},{"optionId":"regularize","text":"正則化(Dropoutなど)を強める","isCorrect":false}],"explanation":"序盤は順調に誤差が下がるが、途中(エポック12付近)から誤差が急激に跳ね上がっている。深いネットワークや再帰的な構造で勾配が層を逆伝播するたびに増幅され、パラメータが発散してしまう勾配爆発の典型例。勾配クリッピングや学習率の低下が有効。","source":"original","sourceRef":"自作","contentVer":"1"}
{"caseId":"g_kentei-failure-0008","examId":"g_kentei","subjectId":"ml_overview","curve":[{"epoch":1,"trainLoss":1.2,"valLoss":1.3},{"epoch":3,"trainLoss":0.8,"valLoss":0.6},{"epoch":5,"trainLoss":0.5,"valLoss":1.1},{"epoch":8,"trainLoss":0.3,"valLoss":0.4},{"epoch":12,"trainLoss":0.2,"valLoss":0.9},{"epoch":16,"trainLoss":0.15,"valLoss":0.3},{"epoch":20,"trainLoss":0.1,"valLoss":0.8}],"symptomOptions":[{"optionId":"bias","text":"訓練・検証データの分布の偏り","isCorrect":true},{"optionId":"overfit","text":"過学習","isCorrect":false},{"optionId":"leakage","text":"データリーク","isCorrect":false},{"optionId":"lr-high","text":"学習率が大きすぎる","isCorrect":false}],"treatmentOptions":[{"optionId":"cross-validate","text":"訓練・検証データの分布を揃える、データを増やす、交差検証を行う","isCorrect":true},{"optionId":"regularize","text":"正則化(Dropoutなど)を強める","isCorrect":false},{"optionId":"fix-split","text":"検証データの前処理を特徴量作成より前に完全に分離する","isCorrect":false},{"optionId":"lr-down","text":"学習率を小さくする","isCorrect":false}],"explanation":"訓練誤差は滑らかに下がり続けるが、検証誤差は大きくジグザグに変動して安定しない。検証データが少なすぎる、または訓練データと検証データの分布が偏っている(代表性がない)ことが原因として考えられる。データを増やす、分布を揃える、交差検証で評価を安定させるなどが有効。","source":"original","sourceRef":"自作","contentVer":"1"}
